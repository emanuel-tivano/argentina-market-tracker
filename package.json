{
  "name": "argentina-market-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Production-oriented full-stack dashboard for the Argentine market, with a stable public demo and configurable live integration.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:e2e": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "next build && npm run test:e2e:run",
    "test:e2e:app": "next build && npm run test:e2e:app:run",
    "test:e2e:app:run": "node ./scripts/run-e2e.mjs --grep-invert @ssr-boot",
    "test:e2e:run": "node ./scripts/run-e2e-suite.mjs",
    "test:e2e:ssr": "next build && npm run test:e2e:ssr:run",
    "test:e2e:ssr:run": "node ./scripts/run-e2e.mjs --mode=ssr e2e/dashboard-ssr.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "validate:local": "npm run lint && npm run type-check && npm run test && npm run build",
    "validate": "npm run validate:local && npm run test:e2e:run",
    "deps:update": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swr": "2.4.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "volta": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
