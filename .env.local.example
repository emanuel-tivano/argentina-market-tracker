# Market data source:
# - demo: deterministic fixture data, no upstream credentials required
# - live: real upstream API with credentials
#
# For public portfolio deploys on Vercel, "demo" is the recommended default.
MARKET_DATA_SOURCE="demo"

# Required only in live mode. Must use HTTPS except for localhost, 127.0.0.1,
# or ::1 during development/tests. A base pathname is allowed; credentials,
# query strings, and fragments are rejected. Trailing slashes are normalized.
# Examples: https://api.example.com or https://api.example.com/v2
API_URL="https://api.example.com"

# Optional in local development.
# Required for a public deploy if you want metadata/Open Graph to resolve to the
# real public origin instead of relying on platform fallbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional token endpoint path (joined below API_URL's base pathname). Live
# mode only. All upstream endpoint values must be relative paths: absolute or
# protocol-relative URLs, query strings, fragments, traversal segments,
# backslashes, control characters, and encoded separators/traversal are rejected.
TOKEN_ENDPOINT="token"

# External API credentials. Live mode only.
# Keep real values in .env.local and Vercel Environment Variables only.
API_USERNAME="your_api_username"
API_PASSWORD="your_api_password"

# Required panel endpoints. Live mode only. They follow the same strict relative
# path policy as TOKEN_ENDPOINT and always resolve within API_URL's origin and
# base pathname.
PANEL_LIDER_ENDPOINT="api/v2/cotizaciones/acciones/merval/argentina"
PANEL_GENERAL_ENDPOINT="api/v2/cotizaciones/acciones/panel%20general/argentina"
PANEL_CEDEARS_ENDPOINT="api/v2/cotizaciones/acciones/cedears/argentina"

# Localhost debug only. Keep disabled in production and on public demos.
# /api/token and /api/panel?raw=1 also require a local host.
ENABLE_TOKEN_DEBUG=0

# Optional app version string exposed by /api/health.
# Useful for Vercel or CI/CD deploy metadata.
APP_VERSION=""

# Optional favorites quote fan-out concurrency for /api/favorites.
# Valid range: decimal integers 1-10. Default: 4. Partial or alternate numeric
# forms such as 4workers, 4.5, 0x4, and 1e1 are invalid and use the default.
FAVORITES_QUOTE_CONCURRENCY="4"

# Panel cache windows in milliseconds. STALE is the maximum total age and must
# be greater than FRESH. Valid ranges: 1000-300000 / 5000-900000.
# Defaults: 30000 / 120000.
PANEL_CACHE_FRESH_TTL_MS="30000"
PANEL_CACHE_STALE_TTL_MS="120000"

# Shared stock quote cache windows in milliseconds for individual quote detail
# and Favorites fan-out. STALE is the maximum total age and must be greater
# than FRESH. Valid ranges: 1000-60000 / 5000-600000. Invalid values, including
# FRESH >= STALE, reset both values to the defaults: 15000 / 120000.
STOCK_QUOTE_FRESH_TTL_MS="15000"
STOCK_QUOTE_STALE_TTL_MS="120000"

# Confirmed upstream quote 404 cache TTL in milliseconds.
# Valid range: 1000-300000. Default: 30000.
STOCK_QUOTE_NOT_FOUND_TTL_MS="30000"

# Optional production-only token for GET /api/debug/metrics.
# Leave empty to keep the endpoint disabled in production.
OBSERVABILITY_DEBUG_TOKEN=""

# Rate limiting strategy:
# - local/dev/test defaults to memory buckets
# - production should prefer redis-rest with a trusted edge proxy
# - if redis-rest is not configured in production, the app falls back to
#   process-local memory buckets and a conservative shared client key
#
# Valid values: auto | memory | redis-rest
RATE_LIMIT_STORE="auto"

# Valid values: none | vercel
# In production on Vercel you can set this to "vercel" to trust platform-owned
# forwarded IP headers instead of user-controlled headers.
RATE_LIMIT_TRUSTED_PROXY="none"

# Optional distributed storage for production-ready rate limiting.
# Upstash Redis / Vercel KV REST-compatible origin and token. HTTPS is required
# in production; HTTP is accepted only for localhost, 127.0.0.1, or ::1 during
# development/tests. Credentials, pathnames, query strings, and fragments are
# rejected.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""

# Redis REST request timeout in milliseconds.
# Valid range: 2000-5000. Default: 3000.
RATE_LIMIT_REDIS_TIMEOUT_MS="3000"

# Controlled test/E2E inputs. Not needed for normal demo or live operation.
# JSON object keyed by lider/general/cedears; unset by default.
PANEL_RESPONSE_FIXTURE_JSON=""

# Set to 1 only when a test must disable the dashboard server prefetch.
# Valid values: 0 | 1. Default behavior when unset: prefetch enabled.
DISABLE_SERVER_DASHBOARD_PREFETCH="0"

# Playwright runner inputs. The project runner sets these automatically.
# Base URL default: http://localhost:3100. Mode: default | ssr.
PLAYWRIGHT_TEST_BASE_URL="http://localhost:3100"
PLAYWRIGHT_E2E_MODE="default"
